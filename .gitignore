# 1. Python Bytecode (automatically generated when running .py files)
__pycache__/
*.py[cod]

# 2. Virtual Environment (created when you run 'python -m venv venv')
venv/
.venv/

# 3. Packaging & Wheel Build Output (created when running 'python -m build')
*.egg-info/

# 4. Linter Caches (created when running mypy or pytest)
.mypy_cache/
.pytest_cache/

# 5. Project Output (the file generated by your maze program)
*.txt
!config.txt
!requirements.txt

*.tar.gz